# =============================================================================
# Copy this file to .env and fill in your own values.
#   cp .env.example .env
#
# IMPORTANT: Never commit .env to Git. It is listed in .gitignore.
# =============================================================================

# ── Blynk ─────────────────────────────────────────────────────────────────────
BLYNK_AUTH_TOKEN=YOUR_BLYNK_AUTH_TOKEN_HERE

# ── YOLO Detection ────────────────────────────────────────────────────────────
CONFIDENCE_THRESHOLD=0.50
NMS_THRESHOLD=0.40
SAVE_ANNOTATED_IMAGES=true

# ── Motion Detection ──────────────────────────────────────────────────────────
MOTION_MIN_AREA=3000
MOTION_THRESHOLD=25
MOTION_BLUR_SIZE=21
MOTION_CONFIRMATION_FRAMES=2
MOTION_COOLDOWN_SECONDS=10
MOTION_LOOP_DELAY=0.1

# ── Camera Preview Stream (motion detection) ──────────────────────────────────
STREAM_WIDTH=640
STREAM_HEIGHT=480

# ── Camera HQ Still (YOLO + storage) ─────────────────────────────────────────
CAPTURE_WIDTH=1920
CAPTURE_HEIGHT=1080
CAMERA_CAPTURE_SETTLE=2.0
CAMERA_WARMUP_SECONDS=2.0
CAMERA_BRIGHTNESS=0.1
CAMERA_CONTRAST=1.1
CAMERA_SHARPNESS=1.2
CAMERA_SATURATION=1.0
MAX_STORED_IMAGES=500

# ── SenseHAT LEDs ─────────────────────────────────────────────────────────────
LED_DETECTION_HOLD_SECONDS=2.0

# ── Event Cooldown ────────────────────────────────────────────────────────────
EVENT_COOLDOWN_SECONDS=15

# ── MQTT ──────────────────────────────────────────────────────────────────────
MQTT_BROKER=broker.hivemq.com
MQTT_PORT=1883
MQTT_USER_ID=iot-detector-YOUR_STUDENT_ID


# ── Cloudinary (leave blank to disable) ──────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=iot-detector

# ── Flask ─────────────────────────────────────────────────────────────────────
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=false

# ── MongoDB Atlas (leave blank to disable) ────────────────────────────────────
#
# How to get your URI:
#   1. Create a free M0 cluster at https://cloud.mongodb.com
#   2. Click "Connect" -> "Drivers" -> copy the connection string
#   3. Replace <password> with your Atlas database user password
#   4. The URI format is:
#      mongodb+srv://<username>:<password>@<cluster>.mongodb.net/
#
# When set, every detection is mirrored to Atlas in addition to SQLite.
# The dashboard reads from MongoDB when this is set, falling back to SQLite.
# Leave blank to run with SQLite only (no cloud persistence).
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/
MONGO_DB_NAME=iot_detector
MONGO_COLLECTION=detections
